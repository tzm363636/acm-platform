# Configure these in the existing Render BACKEND service, not the frontend.
# This file is documentation; Spring Boot does not automatically load it.
SPRING_PROFILES_ACTIVE=aiven,render
DB_ACTION=serve
DB_ENVIRONMENT=cloud
DB_HOST=<aiven-service-host>
DB_PORT=<aiven-service-port>
DB_NAME=<existing-database-name>
DB_USER=<existing-database-user>
DB_PASSWORD=<backend-secret>
DB_EXPECTED_MAJOR=8
# Allocate from the actual Aiven connection budget and number of backend instances.
DB_POOL_MAX=2
# Upload the existing CA as a Render Secret File named ca.pem.
DB_CA_CERT_PATH=/etc/secrets/ca.pem
DB_TRUSTSTORE_PASSWORD=<independent-backend-secret-at-least-6-characters>
# PORT is supplied by Render; the render profile binds 0.0.0.0 and sets Secure cookies.
# No demo seed, administrator initialization or automatic schema migration on startup.
