SPRING_PROFILES_ACTIVE=aiven
PORT=8080
DB_HOST=<service-hostname-from-aiven>
DB_PORT=<service-port-from-aiven>
DB_NAME=<already-created-database>
DB_USER=<least-privilege-service-user>
DB_PASSWORD=<deployment-secret>
DB_EXPECTED_MAJOR=<confirmed-service-major-version>
DB_TRUSTSTORE_PATH=<mounted-truststore-file-path>
DB_TRUSTSTORE_PASSWORD=<deployment-secret>
DB_POOL_MAX=<allocated-connections-per-instance>
DB_ACTION=serve
# Demo seeding and demo writes are always disabled for this profile.
