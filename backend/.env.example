# Documentation template; Spring Boot does NOT automatically read this file.
# Set these in your local shell or deployment secret environment.
SPRING_PROFILES_ACTIVE=mysql-local
PORT=8080
DB_HOST=<development-host>
DB_PORT=<development-port>
DB_NAME=<existing-or-authorized-development-database>
DB_USER=<application-or-migration-user>
DB_PASSWORD=<configure-locally>
DB_EXPECTED_MAJOR=8
DB_SSL_MODE=VERIFY_IDENTITY
DB_TRUSTSTORE_PATH=<optional-truststore-file-path>
DB_TRUSTSTORE_PASSWORD=<configure-locally>
DB_POOL_MAX=4
DB_ACTION=serve
DB_DEMO_ENABLED=false
